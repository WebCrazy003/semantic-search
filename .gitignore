# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
frontend/dist/

# Local data and models: never commit these
documents/*
!documents/.gitkeep
models/*
!models/.gitkeep
qdrant_storage/*
!qdrant_storage/.gitkeep
data/*
!data/.gitkeep

# Offline release builds: prepare-offline.bat writes the finished release into
# release/ and keeps its downloads in .build/. Both are large and reproducible.
release/
.build/

# Secrets and local config
.env

# OS
.DS_Store
