# ---- Documents ----
PDF_DIRECTORY=./documents
PDF_EXTRACT_TABLES=true
PDF_MIN_DOCUMENT_CHARS=20
# A Korean word split over two lines with no hyphen: auto joins it when the PDF
# keeps trailing spaces at word breaks, which is the only evidence available.
# on forces joining, off always leaves a space.
PDF_KOREAN_MIDWORD_JOIN=auto
# Index Word .docx files alongside PDFs. Legacy .doc is not supported.
DOCX_ENABLED=true

# ---- Qdrant ----
# Leave QDRANT_PATH empty to talk to a Qdrant server at QDRANT_URL.
# Set it to a folder and the vectors live there in an embedded Qdrant instead:
# no server, no Docker, no port. This is what the offline Windows install uses.
# Only one process may hold that folder, so stop the backend before running
# scripts/check_qdrant.py or scripts/rebuild_manifest.py against it.
QDRANT_PATH=
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=pdf_passages
QDRANT_TIMEOUT=30
QDRANT_UPSERT_BATCH=128
VECTOR_SIZE=1024

# ---- Embeddings ----
BGE_MODEL_PATH=./models/bge-m3
# auto picks an NVIDIA GPU (RTX 20-series or newer, driver 580+), then Apple
# Silicon (mps), then cpu. A GPU that fails a test kernel is skipped, with the
# reason shown on the Indexing page.
EMBEDDING_DEVICE=auto
# CPU and Apple Silicon. 8 suits 16 GB of shared memory; raise it on a larger machine.
EMBEDDING_BATCH_SIZE=8
# NVIDIA GPU. auto sizes it from the card's memory: 8 below 6 GB, 16 below 10 GB
# (an 8 GB RTX 5060), 32 below 16 GB, else 64. Out of memory halves it and retries.
EMBEDDING_BATCH_SIZE_GPU=auto
# auto is fp16 on an NVIDIA GPU (about twice as fast, half the memory) and fp32
# elsewhere. Vectors from either are compatible, so no re-index is needed.
EMBEDDING_PRECISION=auto
EMBEDDING_MAX_SEQ_LENGTH=512
# Leave false. True is only for the one-time model download.
ALLOW_MODEL_DOWNLOAD=false

# ---- Chunking (preset B) ----
CHUNK_TARGET_TOKENS=300
CHUNK_MAX_TOKENS=450
CHUNK_MIN_TOKENS=80
CHUNK_OVERLAP_TOKENS=50
CHUNK_PRESERVE_HEADINGS=true
CHUNK_REPEAT_HEADING=true
CHUNK_ALLOW_CROSS_PAGE=false
CHUNK_PREFER_PARAGRAPH_BOUNDARIES=true
CHUNK_PREFER_SENTENCE_BOUNDARIES=true

# ---- Search ----
DEFAULT_TOP_K=10
MAX_TOP_K=100

# ---- Storage ----
MANIFEST_PATH=./data/manifest.db
# Accounts, sessions, reset requests and which documents are public. Back this file
# up: unlike the manifest, nothing can rebuild it.
ACCESS_DB_PATH=./data/access.db

# ---- Accounts ----
AUTH_SESSION_IDLE_DAYS=7
AUTH_SESSION_MAX_DAYS=30
# Only behind HTTPS. Over plain HTTP a Secure cookie is never sent back.
AUTH_COOKIE_SECURE=false
# Failed logins per username in 15 minutes before a wait.
AUTH_LOGIN_MAX_FAILURES=5
# How long a password reset request waits for an administrator.
AUTH_RESET_REQUEST_HOURS=24

# ---- Service ----
API_HOST=127.0.0.1
API_PORT=8000
# Only needed for the Vite dev server. An installed copy is served by the API
# itself on one origin, so cross-origin requests never arise.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=INFO
# True logs passage text. Keep false outside debugging.
DEBUG_LOG_TEXT=false

# ---- Hugging Face offline mode ----
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
